# Copiar a .env.local y rellenar. Nunca commits de valores reales.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

BETTER_AUTH_SECRET="generate-with-openssl-rand-hex-32"
BETTER_AUTH_URL="http://localhost:3000"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Imladris <consejo@imladris.online>"

# Web Push (npm run push:vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@imladris.online"

# Obligatorio para /api/cron/lifecycle (Vercel Cron lo envía como Bearer)
CRON_SECRET="generate-with-openssl-rand-hex-32"

# Solo para reactivar POST /api/bootstrap/founder (preferible: npm run email:founder)
# ENABLE_FOUNDER_BOOTSTRAP="true"
